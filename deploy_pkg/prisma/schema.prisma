generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
}

model Agent {
  id            String   @id @default(uuid())
  name          String
  description   String?
  status        String   @default("active")
  createdBy     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  lastSeenAt    DateTime?
  publicKey     String?
  metadata      String?
}